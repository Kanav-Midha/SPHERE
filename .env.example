# ---- Frontend (Vite) ----
# Supabase project URL and anon key. Safe to expose: row level security
# is what actually guards the data, not the key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Restrict Google sign-in to a single institutional domain.
VITE_ALLOWED_GOOGLE_DOMAIN=example.edu

# Set to false to hide the Google button entirely, e.g. on a public demo
# deploy where Google OAuth has not been configured.
VITE_ENABLE_GOOGLE_AUTH=true

# Password for the public demo account (demo@sphere.demo). The demo button
# only appears when this is set. This ships in the client bundle on purpose:
# the account is public and its permissions are capped by RLS policies in
# supabase/migrations/20260927120000_add_demo_account_guardrails.sql.
# Never put the service role key in a VITE_ variable.
VITE_DEMO_PASSWORD=

# ---- Serverless API routes (api/) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Upstash Redis REST credentials. Scan events are buffered here and
# flushed into scan_logs in batches so the scanner stays responsive.
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token
